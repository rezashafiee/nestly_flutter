for_platform :android do
  package_name(ENV.fetch("ANDROID_PACKAGE_NAME", "com.example.nestly"))
  json_key_file(ENV["SUPPLY_JSON_KEY"]) if ENV["SUPPLY_JSON_KEY"]
end

for_platform :ios do
  app_identifier(ENV.fetch("IOS_APP_IDENTIFIER", "com.example.nestly"))
  apple_id(ENV["APPLE_ID"]) if ENV["APPLE_ID"]
  team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
end
