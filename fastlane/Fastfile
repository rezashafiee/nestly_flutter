require "rbconfig"
require "yaml"

default_platform(:android)

def app_version_name
  ENV["APP_VERSION_NAME"].to_s.empty? ? pubspec_version_name : ENV["APP_VERSION_NAME"]
end

def app_build_number
  build_number = ENV["APP_BUILD_NUMBER"].to_s.empty? ? ENV["BUILD_NUMBER"] : ENV["APP_BUILD_NUMBER"]
  build_number.to_s.empty? ? Time.now.strftime("%Y%m%d%H%M") : build_number
end

def pubspec_version_name
  version = YAML.load_file("pubspec.yaml").fetch("version", "1.0.0").to_s
  version.split("+").first
end

def flutter_build_args
  "--build-name=#{app_version_name} --build-number=#{app_build_number}"
end

def ensure_android_signing!
  required = %w[
    ANDROID_KEYSTORE_PATH
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_ALIAS
    ANDROID_KEY_PASSWORD
  ]
  missing = required.select { |name| ENV[name].to_s.empty? }
  return if missing.empty?

  UI.user_error!("Missing Android release signing environment values: #{missing.join(', ')}")
end

def ensure_play_json!
  return unless ENV["SUPPLY_JSON_KEY"].to_s.empty?

  UI.user_error!("Missing SUPPLY_JSON_KEY. Set it to the Google Play service account JSON path.")
end

def ensure_macos!
  return if RbConfig::CONFIG["host_os"].include?("darwin")

  UI.user_error!("iOS lanes must run on a macOS Jenkins agent with Xcode installed.")
end

def app_store_api_key
  required = %w[
    APP_STORE_CONNECT_API_KEY_PATH
    APP_STORE_CONNECT_KEY_ID
    APP_STORE_CONNECT_ISSUER_ID
  ]
  missing = required.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Missing App Store Connect API values: #{missing.join(', ')}") unless missing.empty?

  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    duration: 1200,
    in_house: ENV["APP_STORE_CONNECT_IN_HOUSE"] == "true"
  )
end

def maybe_sync_ios_signing
  return if ENV["MATCH_GIT_URL"].to_s.empty?

  sync_code_signing(
    type: ENV.fetch("MATCH_TYPE", "appstore"),
    readonly: true,
    app_identifier: ENV.fetch("IOS_APP_IDENTIFIER", "com.example.nestly"),
    git_url: ENV["MATCH_GIT_URL"]
  )
end

platform :android do
  desc "Run Flutter dependency restore, analyzer, and tests."
  lane :ci do
    sh("flutter pub get")
    sh("flutter analyze")
    sh("flutter test")
  end

  desc "Build a debug APK for smoke testing."
  lane :build_debug do
    sh("flutter pub get")
    sh("flutter build apk --debug #{flutter_build_args}")
  end

  desc "Build a signed Android App Bundle for Google Play."
  lane :build_release do
    ensure_android_signing!
    sh("flutter pub get")
    sh("flutter build appbundle --release #{flutter_build_args}")
  end

  desc "Validate the Google Play service account JSON key."
  lane :validate_play_key do
    ensure_play_json!
    validate_play_store_json_key(json_key: ENV["SUPPLY_JSON_KEY"])
  end

  desc "Build and upload the Android App Bundle to a Google Play track."
  lane :upload_play do |options|
    ensure_play_json!
    build_release
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.example.nestly"),
      json_key: ENV["SUPPLY_JSON_KEY"],
      aab: "build/app/outputs/bundle/release/app-release.aab",
      track: ENV.fetch("ANDROID_PLAY_TRACK", options[:track] || "internal"),
      release_status: ENV.fetch("ANDROID_RELEASE_STATUS", "completed"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build a signed IPA for App Store Connect."
  lane :build_release do
    ensure_macos!
    maybe_sync_ios_signing
    sh("flutter pub get")

    export_method = ENV.fetch("IOS_EXPORT_METHOD", "app-store")
    export_options = ENV["IOS_EXPORT_OPTIONS_PLIST"].to_s.empty? ? "" : "--export-options-plist=#{ENV['IOS_EXPORT_OPTIONS_PLIST']}"
    sh("flutter build ipa --release #{flutter_build_args} --export-method=#{export_method} #{export_options}".strip)
  end

  desc "Build and upload the IPA to TestFlight."
  lane :upload_testflight do
    build_release
    upload_to_testflight(
      api_key: app_store_api_key,
      ipa: "build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
